{
  "name": "@routeiq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/local.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:lambda": "node build-lambda.mjs",
    "seed": "tsx --conditions=development --env-file=../../.env scripts/seed.ts",
    "seed:dev": "tsx --conditions=development --env-file=../../.env scripts/seed.ts --target=dev",
    "backfill:dues": "tsx --conditions=development --env-file=../../.env scripts/backfill-driver-dues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/client-ssm": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@fastify/aws-lambda": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@routeiq/contracts": "workspace:^",
    "@routeiq/data": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5",
    "jose": "^5.9.6",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/lib-dynamodb": "^3.717.0",
    "esbuild": "^0.24.2"
  }
}