# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=8180
STAGE=local

# --- DynamoDB ----------------------------------------------------------------
# Local: DynamoDB Local in docker. Deployed: leave endpoint unset, use IAM role.
TABLE_NAME=routeiq-local
DDB_ENDPOINT=http://localhost:8200
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- S3 (LocalStack local, real S3 deployed) ---------------------------------
S3_ENDPOINT=http://localhost:4666
S3_BUCKET=routeiq-documents-local
S3_FORCE_PATH_STYLE=true

# --- Auth --------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-replace-me-before-any-deploy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
DRIVER_REFRESH_TOKEN_TTL_DAYS=180

# --- Features ----------------------------------------------------------------
# Platform default; a tenant can override it in its settings.
FEATURE_MAPS=true
# Free OpenStreetMap vector tiles, no API key. Only loaded when FEATURE_MAPS is on.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# On hold — no routing server runs, so nothing is billed. Turning either on requires
# VALHALLA_URL, and the API refuses to start without it.
FEATURE_ROUTING=false
FEATURE_MAP_MATCHING=false
# VALHALLA_URL=http://localhost:8002
